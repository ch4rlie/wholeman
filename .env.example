# Calendly scheduling link used by all "Book a call" CTAs
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro-call

# Circle applications (Resend)
RESEND_API_KEY=
# Comma-separated recipients — both founders
APPLY_TO_EMAIL=
# Optional; defaults to applications@wholeman.org (must be a Resend-verified domain)
APPLY_FROM_EMAIL=
