# Circle applications — sent via Google Workspace SMTP (smtp.gmail.com)
# GMAIL_USER: the Workspace account that sends the mail (e.g. hello@wholeman.org)
GMAIL_USER=
# App password for that account (requires 2-Step Verification; create at
# Google Account → Security → App passwords)
GMAIL_APP_PASSWORD=
# Comma-separated recipients (no spaces needed after commas)
EMAIL_NOTIFICATIONS=
